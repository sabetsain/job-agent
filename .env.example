# OpenCode Go API key for LLM calls (required for live scoring, drafting, ideation, and live evals)
OPENCODE_API_KEY=

# Optional separate API key env var if scoring_api_key_env is overridden in config/llm.yaml
# SCORING_API_KEY=

# Optional Himalayas API key for higher discovery rate limits
# HIMALAYAS_API_KEY=
